{
  "name": "nurturepath-ai",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "build:preview": "node scripts/build-preview.mjs",
    "serve:preview": "node scripts/serve-preview.mjs",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "coach:init": "node scripts/coach-local.mjs init",
    "coach:init:gemini": "node scripts/coach-local.mjs init-gemini",
    "dev:coach:gemini": "node scripts/coach-local.mjs gemini",
    "start:coach:gemini": "node scripts/coach-local.mjs start-gemini",
    "dev:coach": "node scripts/coach-local.mjs dev",
    "start:coach": "node scripts/coach-local.mjs start",
    "build:coach": "next build experiments/coach --webpack",
    "typecheck:coach": "next typegen experiments/coach && tsc --noEmit -p experiments/coach/tsconfig.json",
    "test:coach": "vitest run --config experiments/coach/vitest.config.mts",
    "test:e2e:coach": "playwright test --config experiments/coach/playwright.config.ts",
    "test:e2e:coach:gemini": "node scripts/test-gemini-ui.mjs",
    "coach:public": "node scripts/coach-public.mjs"
  },
  "dependencies": {
    "next": "16.4.3",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.3",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^4.1.12"
  },
  "engines": {
    "node": ">=20.19.0"
  }
}
